# Copy to .env and fill in. Source it before running: `set -a; source .env; set +a`

# Supabase — Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here   # service_role, NOT anon (need write access)

# Voyage — dashboard.voyageai.com
VOYAGE_API_KEY=pa-your_voyage_key_here

# Anthropic — console.anthropic.com (used for image captioning at ingest)
ANTHROPIC_API_KEY=sk-ant-your_key_here
